{
  "name": "nba-fantasy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test:schedule": "node --test src/lib/schedule.test.mjs",
    "test:official-games": "node --test src/lib/officialGames.test.mjs",
    "test:official-completion": "npm --prefix functions test",
    "test:presentation": "node --test src/lib/officialGamePresentation.test.mjs",
    "test:round-progression": "node --test src/lib/seasonProgress.test.mjs",
    "test:standings": "node --test src/lib/standings.test.mjs",
    "test:phase9": "node --test functions/test/postseason.test.js",
    "test:phase10": "node --test functions/test/playoffs.test.js",
    "test:phase11": "node --test functions/test/seasonHistory.test.js",
    "test:phase12": "node --test src/lib/offseasonPreparation.test.mjs",
    "test:phase13": "node --test functions/test/nextSeason.test.js",
    "test:phase15": "node --test functions/test/contracts.test.js",
    "test:phase16": "node --test functions/test/nbaCatalog.test.js src/lib/playerCatalog.test.mjs src/lib/playerHeadshots.test.mjs",
    "test:phase17": "node --test functions/test/freeAgency.test.js src/lib/freeAgency.test.mjs",
    "test:phase18": "node --test functions/test/social.test.js src/lib/socialProfile.test.mjs",
    "test:phase18-rules": "firebase emulators:exec --only firestore \"node --test test/firestore/social.rules.test.mjs\"",
    "test:profile": "node --test src/lib/profileAccess.test.mjs src/lib/profileMedia.test.mjs src/lib/imageCrop.test.mjs src/lib/socialProfile.test.mjs src/lib/socialUi.test.mjs",
    "test:lineup": "node --test src/utils/team.test.mjs src/lib/offseasonPreparation.test.mjs functions/test/lineup.test.js",
    "test:roster-foundation": "node --test src/lib/rosterConfig.test.mjs src/utils/team.test.mjs functions/test/lineup.test.js functions/test/contracts.test.js",
    "test:draft": "node --test functions/test/draftTimer.test.js functions/test/lineupFeasibility.test.js functions/test/preseasonRosterRepair.test.js src/lib/draftTimer.test.mjs src/lib/rosterConfig.test.mjs",
    "test:routes": "node --test src/lib/routeAccess.test.mjs src/lib/profileAccess.test.mjs",
    "test:readiness-rules": "firebase emulators:exec --only firestore \"node --test test/firestore/readiness.rules.test.mjs\"",
    "test:nba-api": "node scripts/testNbaApi.mjs",
    "sync:nba-catalog": "node scripts/syncNbaPlayerCatalog.mjs",
    "audit:player-catalog": "node scripts/auditPlayerCatalog.mjs",
    "test:catalog-audit": "node --test functions/test/catalogAudit.test.js",
    "audit:legacy-player-data": "node scripts/migrateLegacyPlayerData.mjs",
    "migrate:legacy-player-data": "node scripts/migrateLegacyPlayerData.mjs --write --confirm",
    "preview": "vite preview",
    "migrate:player-catalog-metadata": "node scripts/migratePlayerCatalogMetadata.mjs"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-admin": "^14.2.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
