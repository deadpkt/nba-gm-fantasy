rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isLeagueMember(leagueId) {
      return signedIn()
        && get(/databases/$(database)/documents/leagues/$(leagueId))
          .data.memberIds.hasAny([request.auth.uid]);
    }

    function isCommissioner(leagueId) {
      return isLeagueMember(leagueId)
        && request.auth.uid == get(/databases/$(database)/documents/leagues/$(leagueId)).data.commissionerUid;
    }

    function onlyProfileFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName', 'email', 'photoURL', 'bannerURL', 'activeLeagueId', 'updatedAt'
      ]);
    }

    function isNewProfile() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'bannerURL', 'activeLeagueId', 'createdAt',
          'updatedAt'
        ]);
    }

    function readyMemberIds(leagueData) {
      return leagueData.get('readyMemberIds', []);
    }

    function hasCurrentRosterConfig(leagueData) {
      let config = leagueData.get('rosterConfig', {});
      return config.keys().hasOnly(['version', 'rosterSize', 'starterCount', 'benchSize'])
        && config.version == 2
        && config.rosterSize == 8
        && config.starterCount == 5
        && config.benchSize == 3;
    }

    function leagueRosterSize(leagueData) {
      return hasCurrentRosterConfig(leagueData) ? 8 : 5;
    }

    function hasValidSeasonConfig(leagueData) {
      let config = leagueData.seasonConfig;
      return leagueData.maxMembers in [2, 4, 6, 8]
        && config.keys().hasOnly([
          'preset', 'gamesPerTeam', 'scheduleVersion'
        ])
        && config.scheduleVersion == 1
        && ((config.preset == 'SHORT'
            && config.gamesPerTeam == (leagueData.maxMembers - 1) * 2)
          || (config.preset == 'STANDARD'
            && config.gamesPerTeam == (leagueData.maxMembers - 1) * 4)
          || (config.preset == 'FULL'
            && config.gamesPerTeam == (leagueData.maxMembers - 1) * 8));
    }

    function hasValidScheduleMetadata(leagueData) {
      let schedule = leagueData.schedule;
      return hasValidSeasonConfig(leagueData)
        && schedule.keys().hasOnly([
          'version', 'generatedForSeason', 'totalGames', 'totalRounds',
          'generatedAt'
        ])
        && schedule.version == leagueData.seasonConfig.scheduleVersion
        && schedule.generatedForSeason == leagueData.season
        && schedule.totalGames
          == leagueData.memberIds.size() * leagueData.seasonConfig.gamesPerTeam / 2
        && schedule.totalRounds == leagueData.seasonConfig.gamesPerTeam
        && schedule.generatedAt == request.time;
    }

    function hasInitialSeasonProgress(leagueData) {
      let progress = leagueData.seasonProgress;
      return progress.keys().hasOnly([
          'currentRound', 'roundStatus', 'totalRounds',
          'regularSeasonComplete'
        ])
        && progress.currentRound == 1
        && progress.roundStatus == 'pending'
        && progress.totalRounds == leagueData.schedule.totalRounds
        && progress.regularSeasonComplete == false;
    }

    function seasonReadyMemberIds(leagueData) {
      return leagueData.get('seasonReadyMemberIds', []);
    }

    function offseasonReadyMemberIds(leagueData) {
      return leagueData.get('offseason', {}).get('readyMemberIds', []);
    }

    function hasValidFivePlayerLineup(leagueId, team) {
      return team.roster.size() == leagueRosterSize(get(/databases/$(database)/documents/leagues/$(leagueId)).data)
        && team.lineup.keys().hasOnly(['PG', 'SG', 'SF', 'PF', 'C'])
        && rosterPlayerEligible(team, team.lineup.PG, 'PG')
        && rosterPlayerEligible(team, team.lineup.SG, 'SG')
        && rosterPlayerEligible(team, team.lineup.SF, 'SF')
        && rosterPlayerEligible(team, team.lineup.PF, 'PF')
        && rosterPlayerEligible(team, team.lineup.C, 'C')
        && team.lineup.PG != team.lineup.SG
        && team.lineup.PG != team.lineup.SF
        && team.lineup.PG != team.lineup.PF
        && team.lineup.PG != team.lineup.C
        && team.lineup.SG != team.lineup.SF
        && team.lineup.SG != team.lineup.PF
        && team.lineup.SG != team.lineup.C
        && team.lineup.SF != team.lineup.PF
        && team.lineup.SF != team.lineup.C
        && team.lineup.PF != team.lineup.C;
    }

    function playerEligible(player, position) {
      return player.get('eligiblePositions', []).hasAny([position])
        || player.get('primaryPosition', player.get('position', '')) == position
        || player.get('position', '') == position
        || (player.get('position', '') == 'G' && position in ['PG', 'SG'])
        || (player.get('position', '') == 'F' && position in ['SF', 'PF'])
        || (player.get('position', '') in ['G-F', 'F-G'] && position in ['SG', 'SF'])
        || (player.get('position', '') in ['F-C', 'C-F'] && position in ['PF', 'C']);
    }

    function rosterPlayerEligible(team, playerId, position) {
      return (team.roster[0].id == playerId && playerEligible(team.roster[0], position))
        || (team.roster[1].id == playerId && playerEligible(team.roster[1], position))
        || (team.roster[2].id == playerId && playerEligible(team.roster[2], position))
        || (team.roster[3].id == playerId && playerEligible(team.roster[3], position))
        || (team.roster[4].id == playerId && playerEligible(team.roster[4], position))
        || (team.roster.size() == 8
          && ((team.roster[5].id == playerId && playerEligible(team.roster[5], position))
            || (team.roster[6].id == playerId && playerEligible(team.roster[6], position))
            || (team.roster[7].id == playerId && playerEligible(team.roster[7], position))));
    }

    function addsOnlyAuthenticatedMember(before, after) {
      return !(request.auth.uid in before)
        && request.auth.uid in after
        && after.hasAll(before)
        && after.size() == before.size() + 1;
    }

    function removesOnlyAuthenticatedMember(before, after) {
      return request.auth.uid in before
        && !(request.auth.uid in after)
        && before.hasAll(after)
        && after.size() == before.size() - 1;
    }

    function isOwnSeasonReadinessUpdate(leagueId) {
      let before = seasonReadyMemberIds(resource.data);
      let after = seasonReadyMemberIds(request.resource.data);
      let teamAfter = getAfter(/databases/$(database)/documents/leagues/$(leagueId)/teams/$(request.auth.uid)).data;
      return signedIn()
        && resource.data.status == 'season_ready'
        && request.resource.data.status == 'season_ready'
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'seasonReadyMemberIds', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && teamAfter.ownerUid == request.auth.uid
        && ((addsOnlyAuthenticatedMember(before, after)
            && hasValidFivePlayerLineup(leagueId, teamAfter))
          || removesOnlyAuthenticatedMember(before, after));
    }

    function isSeasonReadyLineupUpdate(leagueId, userId) {
      let league = get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      let leagueAfter = getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data;
      return league.status == 'season_ready'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lineup', 'updatedAt'
        ])
        && request.resource.data.roster == resource.data.roster
        && request.resource.data.updatedAt == request.time
        && !(userId in seasonReadyMemberIds(leagueAfter));
    }

    function isOwnOffseasonReadinessUpdate(leagueId) {
      let before = offseasonReadyMemberIds(resource.data);
      let after = offseasonReadyMemberIds(request.resource.data);
      let offseasonBefore = resource.data.offseason;
      let offseasonAfter = request.resource.data.offseason;
      let teamAfter = getAfter(/databases/$(database)/documents/leagues/$(leagueId)/teams/$(request.auth.uid)).data;
      return signedIn()
        && resource.data.status == 'offseason'
        && request.resource.data.status == 'offseason'
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offseason', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && offseasonAfter.keys().hasOnly(['seasonCompleted', 'nextSeason', 'status', 'startedAt', 'preparationVersion', 'readyMemberIds'])
        && offseasonAfter.seasonCompleted == offseasonBefore.seasonCompleted
        && offseasonAfter.nextSeason == resource.data.season + 1
        && offseasonAfter.status == offseasonBefore.status
        && offseasonAfter.startedAt == offseasonBefore.startedAt
        && offseasonAfter.preparationVersion == 1
        && teamAfter.ownerUid == request.auth.uid
        && ((addsOnlyAuthenticatedMember(before, after)
            && hasValidFivePlayerLineup(leagueId, teamAfter))
          || removesOnlyAuthenticatedMember(before, after));
    }

    function isOffseasonLineupUpdate(leagueId, userId) {
      let league = get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      let leagueAfter = getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data;
      return league.status == 'offseason'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineup', 'updatedAt'])
        && request.resource.data.roster == resource.data.roster
        && request.resource.data.updatedAt == request.time
        && !(userId in offseasonReadyMemberIds(leagueAfter));
    }

    function isInSeasonTeamConfigurationUpdate(leagueId) {
      let status = get(/databases/$(database)/documents/leagues/$(leagueId)).data.status;
      return status in ['regular_season', 'playoffs']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'lineup', 'coachStrategy', 'strategy', 'updatedAt'
        ]);
    }

    function isCancelledLeagueReferenceCleanup() {
      return signedIn()
        && resource.data.activeLeagueId != null
        && request.resource.data.activeLeagueId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeLeagueId', 'updatedAt'
        ])
        && getAfter(/databases/$(database)/documents/leagues/$(resource.data.activeLeagueId)).data.status == 'cancelled'
        && getAfter(/databases/$(database)/documents/leagues/$(resource.data.activeLeagueId)).data.commissionerUid == request.auth.uid;
    }

    // The catalog is published by a trusted server-side workflow. Clients can
    // read it but must never be able to alter the shared player pool.
    match /playerCatalogs/{catalogId} {
      allow get: if signedIn() && catalogId == 'current';

      match /players/{playerId} {
        allow get, list: if signedIn() && catalogId == 'current';
      }
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && isNewProfile();
      allow update: if signedIn() && request.auth.uid == userId
        && onlyProfileFieldsChanged()
        || isCancelledLeagueReferenceCleanup();

    }

    match /leagues/{leagueId} {
      // An invite URL needs to resolve its league document before its visitor joins.
      // Membership and roster subcollections remain private to league members.
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.commissionerUid == request.auth.uid
        && hasValidSeasonConfig(request.resource.data)
        && hasCurrentRosterConfig(request.resource.data)
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.readyMemberIds.size() == 0
        && request.resource.data.status == 'lobby';
      allow update: if (isCommissioner(leagueId)
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'drafting'
          && resource.data.memberIds.size() == resource.data.maxMembers
          && readyMemberIds(resource.data).size() == resource.data.memberIds.size()
          && readyMemberIds(resource.data).hasAll(resource.data.memberIds)
          && getAfter(/databases/$(database)/documents/leagues/$(leagueId)/draft/state).data.status == 'active'
          && getAfter(/databases/$(database)/documents/leagues/$(leagueId)/draft/state).data.picksMade == 0
          && getAfter(/databases/$(database)/documents/leagues/$(leagueId)/draft/state).data.draftOrder == resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'draftStartedAt', 'updatedAt'
          ]))
        || (isCommissioner(leagueId)
          && resource.data.status == 'season_ready'
          && request.resource.data.status == 'regular_season'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'seasonConfig', 'schedule', 'seasonProgress',
            'seasonStartedAt', 'updatedAt'
          ])
          && hasValidScheduleMetadata(request.resource.data)
          && hasInitialSeasonProgress(request.resource.data)
          && seasonReadyMemberIds(resource.data).size() == resource.data.memberIds.size()
          && seasonReadyMemberIds(resource.data).hasAll(resource.data.memberIds)
          && request.resource.data.seasonStartedAt == request.time
          && request.resource.data.updatedAt == request.time)
        || isOwnSeasonReadinessUpdate(leagueId)
        || isOwnOffseasonReadinessUpdate(leagueId)
        || (isCommissioner(leagueId)
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'cancelledAt', 'updatedAt'
          ]))
        || (signedIn()
          && resource.data.status == 'lobby'
          && !(request.auth.uid in resource.data.memberIds)
          && resource.data.memberIds.size() < resource.data.maxMembers
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.hasAll([request.auth.uid])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)
        || (signedIn()
          && resource.data.status == 'lobby'
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readyMemberIds', 'updatedAt'
          ])
          && ((!(request.auth.uid in readyMemberIds(resource.data))
              && request.auth.uid in request.resource.data.readyMemberIds
              && request.resource.data.readyMemberIds.hasAll(readyMemberIds(resource.data))
              && request.resource.data.readyMemberIds.size() == readyMemberIds(resource.data).size() + 1)
            || (request.auth.uid in readyMemberIds(resource.data)
              && !(request.auth.uid in request.resource.data.readyMemberIds)
              && readyMemberIds(resource.data).hasAll(request.resource.data.readyMemberIds)
              && request.resource.data.readyMemberIds.size() == readyMemberIds(resource.data).size() - 1)))
        || (signedIn()
          && resource.data.status == 'lobby'
          && request.auth.uid != resource.data.commissionerUid
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberIds', 'readyMemberIds', 'updatedAt'
          ])
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && readyMemberIds(resource.data).hasAll(request.resource.data.readyMemberIds)
          && !(request.auth.uid in request.resource.data.readyMemberIds)
          && request.resource.data.readyMemberIds.size()
            == readyMemberIds(resource.data).size()
              - (request.auth.uid in readyMemberIds(resource.data) ? 1 : 0));

      match /members/{userId} {
        allow get, list: if isLeagueMember(leagueId);
        allow create: if signedIn() && request.auth.uid == userId
          && getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds.hasAll([userId])
          && request.resource.data.uid == userId
          && request.resource.data.ready == false
          && (request.resource.data.role == 'member'
            || (request.resource.data.role == 'commissioner'
              && getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.commissionerUid == userId));
        allow update: if signedIn()
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/leagues/$(leagueId)).data.status == 'lobby'
          && request.resource.data.ready is bool
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ready', 'updatedAt'
          ]);
        allow delete: if signedIn()
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/leagues/$(leagueId)).data.status == 'lobby'
          && request.auth.uid != get(/databases/$(database)/documents/leagues/$(leagueId)).data.commissionerUid
          && !(request.auth.uid in getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds);
      }

      match /teams/{userId} {
        allow get, list: if isLeagueMember(leagueId);
        allow create: if signedIn() && request.auth.uid == userId
          && getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds.hasAll([userId])
          && request.resource.data.ownerUid == userId;
        allow update: if isLeagueMember(leagueId) && request.auth.uid == userId
          && (isSeasonReadyLineupUpdate(leagueId, userId)
            || isOffseasonLineupUpdate(leagueId, userId)
            || isInSeasonTeamConfigurationUpdate(leagueId));
        allow delete: if signedIn()
          && request.auth.uid == userId
          && resource.data.ownerUid == userId
          && resource.data.roster.size() == 0
          && get(/databases/$(database)/documents/leagues/$(leagueId)).data.status == 'lobby'
          && !(request.auth.uid in getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds);
      }

      match /seasons/{seasonId} {
        allow get, list: if isLeagueMember(leagueId);
        allow create, update, delete: if false;
      }

      match /contracts/{playerId} {
        allow get, list: if isLeagueMember(leagueId);
        allow create, update, delete: if false;
      }

      match /games/{gameId} {
        allow get, list: if isLeagueMember(leagueId);
        allow create: if isCommissioner(leagueId)
          && get(/databases/$(database)/documents/leagues/$(leagueId)).data.status
            == 'season_ready'
          && getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.status
            == 'regular_season'
          && hasValidScheduleMetadata(
            getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data
          )
          && request.resource.data.keys().hasOnly([
            'leagueId', 'season', 'scheduleVersion', 'round', 'gameNumber',
            'homeUid', 'awayUid', 'homeTeamName', 'awayTeamName', 'status',
            'scheduledOrder', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.leagueId == leagueId
          && request.resource.data.season
            == getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.season
          && request.resource.data.scheduleVersion
            == getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.schedule.version
          && request.resource.data.round is int
          && request.resource.data.round >= 1
          && request.resource.data.round
            <= getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.schedule.totalRounds
          && request.resource.data.gameNumber is int
          && request.resource.data.gameNumber >= 1
          && request.resource.data.gameNumber
            <= getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.schedule.totalGames
          && request.resource.data.scheduledOrder == request.resource.data.gameNumber
          && request.resource.data.homeUid != request.resource.data.awayUid
          && request.resource.data.homeUid in getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds
          && request.resource.data.awayUid in getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds
          && request.resource.data.homeTeamName is string
          && request.resource.data.awayTeamName is string
          && request.resource.data.status == 'scheduled'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if false;
        allow delete: if false;
      }

      match /playerOwnership/{playerId} {
        allow get, list: if isLeagueMember(leagueId);
        allow create: if false;
        allow delete: if false;
      }

      match /draft/{draftId} {
        allow get: if draftId == 'state' && isLeagueMember(leagueId);
        allow create: if draftId == 'state'
          && isCommissioner(leagueId)
          && getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.status == 'drafting'
          && request.resource.data.keys().hasOnly([
            'leagueId', 'status', 'draftOrder', 'currentRound',
            'currentPickInRound', 'currentPickNumber', 'currentDrafterUid',
            'picksMade', 'totalRounds', 'lastPick', 'pickStartedAt', 'pickDeadlineAt',
            'startedAt', 'updatedAt', 'completedAt'
          ])
          && request.resource.data.leagueId == leagueId
          && request.resource.data.status == 'active'
          && request.resource.data.draftOrder
            == getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds
          && request.resource.data.currentRound == 1
          && request.resource.data.currentPickInRound == 1
          && request.resource.data.currentPickNumber == 1
          && request.resource.data.currentDrafterUid == request.resource.data.draftOrder[0]
          && request.resource.data.picksMade == 0
          && request.resource.data.totalRounds
            == leagueRosterSize(getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data)
          && request.resource.data.lastPick == null
          && request.resource.data.pickStartedAt == null
          && request.resource.data.pickDeadlineAt == null
          && request.resource.data.startedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.completedAt == null;
        allow update: if false;

        match /picks/{playerId} {
          allow get, list: if isLeagueMember(leagueId);
          allow create: if false;
        }
      }

      match /trades/{tradeId} {
        allow get, list: if isLeagueMember(leagueId)
          && (resource.data.senderUid == request.auth.uid
            || resource.data.receiverUid == request.auth.uid);
        allow create: if isLeagueMember(leagueId)
          && request.resource.data.keys().hasOnly([
            'leagueId', 'senderUid', 'receiverUid', 'senderTeam', 'receiverTeam',
            'offeredPlayerIds', 'requestedPlayerIds', 'offeredPlayers',
            'requestedPlayers', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.leagueId == leagueId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverUid != request.auth.uid
          && get(/databases/$(database)/documents/leagues/$(leagueId))
            .data.memberIds.hasAny([request.resource.data.receiverUid])
          && request.resource.data.status == 'pending'
          && request.resource.data.offeredPlayerIds.size() > 0
          && request.resource.data.requestedPlayerIds.size() > 0;
      }
    }

  }
}
